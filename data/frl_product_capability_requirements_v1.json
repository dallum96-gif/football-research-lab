      "known_requirement_notes": [
        "Initial fixture intelligence forms an independent football opinion and does not require bookmaker odds.",
        "A future odds layer should be kept separate from ordinary football evidence and used for explicit market-value questions.",
        "Time-safe current player evidence is particularly valuable for this experience."
      ]
    },
    {
      "id": "RESEARCH_EXPLORER",
      "name": "Research Explorer",
      "primary_question": "What evidence do we possess and what football question can I interrogate?",
      "entry_entity": "Variable or entity",
      "summary_priority": "breadth_with_progressive_disclosure",
      "required_capability_families": [
        {"id": "UNIVERSAL_VARIABLE_ACCESS", "priority": "P0", "natural_grains": ["Fixture", "Team-Fixture", "Player-Fixture", "Team-Season", "Player-Season", "Event", "Context"], "examples": ["governed retrieval", "coverage", "provenance", "transformation"]},
        {"id": "GENERIC_TRANSFORMATIONS", "priority": "P0", "natural_grains": ["Analysis"], "examples": ["totals", "rates", "per-match", "per-90 where valid", "splits", "rolling windows"]},
        {"id": "POPULATION_COMPARISON", "priority": "P0", "natural_grains": ["Analysis"], "examples": ["rank", "percentile", "distribution", "cohort"]},
        {"id": "VARIABLE_DISCOVERY", "priority": "P1", "natural_grains": ["Metadata"], "examples": ["families", "definitions", "season availability", "source routes", "limitations"]}
      ]
    }
  ],
  "acquisition_priority_scoring": {
    "dimensions": [
      "number_of_product_experiences_unlocked",
